# GitHub personal access token with read:org and public_repo scopes.
# Unauthenticated rate limit is 60 req/hr; authenticated is 5000 req/hr.
# Required for Sub-Tasks 4, 5, 6.
GITHUB_TOKEN=ghp_...

# Absolute or relative path to a local checkout of tektoncd/community.
# Required for Sub-Tasks 2 and 3.
COMMUNITY_REPO_PATH=/path/to/tektoncd/community
